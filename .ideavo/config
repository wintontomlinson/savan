{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "npm ci"
    }
  ],
  "codeChecks": [
    {
      "name": "Lint Project",
      "command": "npm run lint"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "npm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "npm run dev -- --host 0.0.0.0 --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [
    {
      "name": "Deploy to Vercel",
      "command": "npx vercel --prod"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "dist",
    ".vite",
    "test-results",
    "playwright-report"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
